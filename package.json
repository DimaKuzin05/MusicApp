{
  "name": "musicapp",
  "version": "1.0.0",
  "description": "Music Player — Electron OOP Lab",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && cp src/renderer/index.html src/renderer/styles.css dist/renderer/",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "private": true,
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.university.musicapp",
    "productName": "MusicApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ru_RU"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
